<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingPermission">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        android:minSdkVersion="34" />

    <!-- Needed for Khwab Aura: live weather lookup -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed for Khwab Aura: real device location used to fetch local weather -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".KhwabApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Khwab"
        android:usesCleartextTraffic="false"
        tools:replace="android:icon"
        tools:remove="android:appCategory,android:extractNativeLibs">

        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Khwab"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Khwab" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Khwab"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Override Unity UnityPlayerActivity: keep it non-exported so it does not
            appear as a launchable entry point. Unity still registers it via
            manifest merge; we just prevent it from being exported.
        -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:exported="false"
            tools:replace="android:exported" />

        <service
            android:name=".service.VoiceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            Khwab Accessibility Service.
            The user must enable this manually in:
              Settings → Accessibility → Downloaded Apps → Khwab
        -->
        <service
            android:name=".service.KhwabAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />

        </service>

    </application>

</manifest>